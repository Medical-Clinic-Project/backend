{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=clinic.db"
  },

  "Jwt": {
    "Issuer": "ClinicApi",
    "Audience": "ClinicFrontend"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },

  "AllowedHosts": "*"
}
